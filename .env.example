# Copy this file to .env (or set these as environment variables in your
# hosting provider's dashboard) — never commit real values to git.

# REQUIRED. Your AI Builders API key (starts with sk_...).
# Get / rotate it at https://space.ai-builders.com
AI_BUILDER_TOKEN=sk_your_token_here

# Optional. Overrides the default API base URL.
# Default used by server.js: https://space.ai-builders.com/backend
# AI_BUILDER_BASE_URL=https://space.ai-builders.com/backend

# Optional. Overrides the default model.
# Default used by server.js: supermind-agent-v1
# AI_BUILDER_MODEL=supermind-agent-v1

# Optional. Port the server listens on (most hosts set this for you).
# PORT=3000
